# ============================================================
# DEEP CUT — Environment Variables
# Salin file ini menjadi `.env.local` lalu isi nilainya.
# ============================================================

# URL proyek Supabase (dari Dashboard Supabase → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://qdgmxtnqppfrijlvtbhf.supabase.co

# Anon / publishable key (aman untuk client-side).
# Bisa memakai format baru `sb_publishable_...` maupun JWT anon lama —
# `lib/supabase/env.ts` menerima keduanya.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Service role key (WAJIB hanya untuk server-side, JANGAN pernah dipakai di client)
# Kunci ini mem-bypass RLS — simpan rahasia.
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...

# Catatan penting di Vercel:
#   NEXT_PUBLIC_SUPABASE_URL dan NEXT_PUBLIC_SUPABASE_ANON_KEY bertipe
#   "Plain Text", BUKAN "Secret". Variabel ber-prefix NEXT_PUBLIC_ memang
#   dikirim ke browser, jadi menandainya Secret tidak menambah keamanan —
#   tetapi membuat `vercel env pull` menghasilkan literal "[SENSITIVE]"
#   sehingga pengembangan lokal gagal tanpa penjelasan.
#   SUPABASE_SERVICE_ROLE_KEY tetap "Secret".
